+struct llama_model * llama_model_load_from_fd(int fd, uint64_t offset, uint64_t length, struct llama_model_params params) {
+    // A file mapping keeps each byte at (file offset mod page size) within its page, so tensor
+    // pointers inherit the window offset's low bits. The CPU backend requires 32-byte alignment.
+    const uint64_t tensor_alignment = 32;
+    if (offset % tensor_alignment != 0) {
+        LLAMA_LOG_ERROR("%s: window offset %llu is not a multiple of %llu; re-align the container entry\n",
+                __func__, (unsigned long long) offset, (unsigned long long) tensor_alignment);
+        return nullptr;
+    }
+    FILE * file = llama_file_window_open(fd, offset, length);
+    if (!file) {
+        LLAMA_LOG_ERROR("%s: failed to open fd %d window [%llu, +%llu): %s\n", __func__, fd,
+                (unsigned long long) offset, (unsigned long long) length, strerror(errno));
+        return nullptr;
+    }
+    struct llama_model * model = llama_model_load_from_file_ptr(file, params);
+    fclose(file);
+    return model;
+}
