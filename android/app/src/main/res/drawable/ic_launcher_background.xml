<?xml version="1.0" encoding="utf-8"?>
<!-- The ground behind the mark, flat on purpose.

     #5D131F is sampled from the artwork's own field, not chosen to be near it, so the foreground's
     square and this meet with no seam. That matters more on Android than on iOS: the foreground
     square is sized to the 66dp safe zone, so every OEM mask — circle, squircle, teardrop, whatever
     Samsung is doing this year — cuts its corners and shows this through. Same colour, invisible
     join, under any mask.

     Flat rather than a gradient for the same reason: a gradient would have to line up with the
     artwork's own shading through a crop nobody can predict. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:fillColor="#FF5D131F" android:pathData="M0,0h108v108h-108z" />
</vector>
