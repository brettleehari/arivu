+// file windows: FILE * -> (fd, offset) so llama_mmap can map the real descriptor
+
+struct llama_file_window {
+    int      fd;
+    uint64_t offset;
+    uint64_t length;
+    uint64_t pos;
+};
+
+static std::mutex & llama_file_window_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+static std::map<FILE *, llama_file_window *> & llama_file_windows() {
+    static std::map<FILE *, llama_file_window *> m;
+    return m;
+}
+
+#if !defined(_WIN32)
+static ssize_t llama_file_window_read_impl(llama_file_window * w, char * buf, size_t n) {
+    if (w->pos >= w->length) {
+        return 0;
+    }
+    n = (size_t) std::min<uint64_t>(n, w->length - w->pos);
+    ssize_t ret;
+    do {
+        ret = pread(w->fd, buf, n, (off_t) (w->offset + w->pos));
+    } while (ret == -1 && errno == EINTR);
+    if (ret > 0) {
+        w->pos += (uint64_t) ret;
+    }
+    return ret;
+}
+
+static int64_t llama_file_window_seek_impl(llama_file_window * w, int64_t off, int whence) {
+    int64_t base;
+    switch (whence) {
+        case SEEK_SET: base = 0; break;
+        case SEEK_CUR: base = (int64_t) w->pos; break;
+        case SEEK_END: base = (int64_t) w->length; break;
+        default: errno = EINVAL; return -1;
+    }
+    if (base + off < 0) {
+        errno = EINVAL;
+        return -1;
+    }
+    w->pos = (uint64_t) (base + off);
+    return (int64_t) w->pos;
+}
+
+static void llama_file_window_forget(llama_file_window * w) {
+    std::lock_guard<std::mutex> lock(llama_file_window_mutex());
+    auto & windows = llama_file_windows();
+    for (auto it = windows.begin(); it != windows.end(); ++it) {
+        if (it->second == w) {
+            windows.erase(it);
+            break;
+        }
+    }
+}
+
+#if defined(__APPLE__) || defined(__ANDROID__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__)
+static int llama_file_window_read(void * c, char * buf, int n) {
+    return (int) llama_file_window_read_impl((llama_file_window *) c, buf, (size_t) n);
+}
+static fpos_t llama_file_window_seek(void * c, fpos_t off, int whence) {
+    return (fpos_t) llama_file_window_seek_impl((llama_file_window *) c, (int64_t) off, whence);
+}
+static int llama_file_window_close(void * c) {
+    auto * w = (llama_file_window *) c;
+    llama_file_window_forget(w);
+    close(w->fd);
+    delete w;
+    return 0;
+}
+#elif defined(__linux__)
+static ssize_t llama_file_window_read(void * c, char * buf, size_t n) {
+    return llama_file_window_read_impl((llama_file_window *) c, buf, n);
+}
+static int llama_file_window_seek(void * c, off64_t * off, int whence) {
+    int64_t ret = llama_file_window_seek_impl((llama_file_window *) c, (int64_t) *off, whence);
+    if (ret < 0) {
+        return -1;
+    }
+    *off = ret;
+    return 0;
+}
+static int llama_file_window_close(void * c) {
+    auto * w = (llama_file_window *) c;
+    llama_file_window_forget(w);
+    close(w->fd);
+    delete w;
+    return 0;
+}
+#endif
+#endif
+
+FILE * llama_file_window_open(int fd, uint64_t offset, uint64_t length) {
+#if defined(_WIN32)
+    GGML_UNUSED(fd);
+    GGML_UNUSED(offset);
+    GGML_UNUSED(length);
+    errno = ENOTSUP;
+    return nullptr;
+#else
+    int own_fd = dup(fd);
+    if (own_fd == -1) {
+        return nullptr;
+    }
+    auto * w = new llama_file_window{ own_fd, offset, length, 0 };
+    FILE * fp = nullptr;
+#if defined(__APPLE__) || defined(__ANDROID__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__)
+    fp = funopen(w, llama_file_window_read, nullptr, llama_file_window_seek, llama_file_window_close);
+#elif defined(__linux__)
+    cookie_io_functions_t io = { llama_file_window_read, nullptr, llama_file_window_seek, llama_file_window_close };
+    fp = fopencookie(w, "rb", io);
+#endif
+    if (fp == nullptr) {
+        close(own_fd);
+        delete w;
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(llama_file_window_mutex());
+    llama_file_windows()[fp] = w;
+    return fp;
+#endif
+}
