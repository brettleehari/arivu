/* ---------------------------------------------------------------------------------------------
   How Arivu works — the learning page (leaves/design.md §8a).

   Arivu is two things at once: an appliance you do not have to understand, and a way to understand
   what an appliance like this actually is. The chat screen serves the first. This page serves the
   second, one tap inside About, where nobody meets it by accident.

   Every number on it is read from the shipped profile and from the phone at that moment. Nothing is
   typed in here, so it cannot go stale when the profile changes — which is the difference between a
   page that teaches and a page that used to be true.
   --------------------------------------------------------------------------------------------- */
"about_learn_link" = "How Arivu works";
"learn_title" = "How Arivu works";
"learn_intro_body" = "Arivu runs a language model on this phone. Nothing is sent anywhere. These are the real numbers it is running with right now.";

"learn_model_title" = "The model";
"learn_model_body" = "A language model is a file of numbers, called weights, that turns text you give it into text it predicts should follow. Arivu ships one and never downloads another. Smaller models need less memory and answer faster; they also know less, which is why Arivu asks you to bring your own text rather than asking it for facts.";
"learn_model_name" = "Model";
"learn_model_quant" = "Precision";
"learn_model_quant_value" = "Q4_K_M — about 4 bits per weight";
"learn_model_size" = "Size on disk";
"learn_model_licence" = "Licence";
"learn_model_licence_value" = "Apache-2.0, weights included";

"learn_context_title" = "How much it can read at once";
"learn_context_body" = "The model reads in tokens, not words — roughly three tokens for every four words. Everything it can see at once, your text and its reply together, has to fit in the context. When a conversation grows past it, Arivu shows a line above the oldest message it can still see, rather than quietly forgetting.";
"learn_context_window" = "Context";
"learn_context_reply" = "Longest reply";
"learn_context_reserve" = "Held back for the reply";
"learn_tokens_value" = "%1$d tokens";
"learn_tokens_approx" = "%1$d tokens, about %2$d words";

"learn_memory_title" = "Why it fits";
"learn_memory_body" = "The weights are mapped straight from the app, not copied into memory, so the phone can drop them and read them back at any time. That half is nearly free. What actually counts against Arivu is its working memory: the notes it keeps about the conversation so far, plus scratch space. Keeping those small is the whole reason a model like this fits a phone at all.";
"learn_memory_weights" = "Weights, shared with the system";
"learn_memory_working" = "Working memory";
"learn_memory_peak" = "Most it should ever need";
"learn_memory_now" = "Using right now";
"learn_memory_unmeasured" = "not measured";

"learn_speed_title" = "How it runs";
"learn_speed_body" = "Arivu runs on the processor, not the graphics chip. On a phone the two share one pool of memory, and moving the model to the graphics chip would turn memory the system can reclaim into memory it cannot — which is the trade that lets Arivu run on a cheap phone at all. It uses the fast cores only; filling the slower ones makes replies arrive later, not sooner.";
"learn_speed_threads" = "Cores used";
"learn_speed_backend" = "Runs on";
"learn_speed_backend_value" = "Processor only";
"learn_engine_core" = "Engine";

/* The model card, read from the GGUF at runtime (D-061). */
"learn_card_title" = "What is in the file";
"learn_card_body" = "These are read from the model file itself when Arivu loads it, not written down here. A model is a stack of layers; each layer has attention heads that decide which earlier words matter. Arivu's model has fewer key-value heads than attention heads — several heads share one set of notes — and that sharing is the single reason its memory of the conversation is small enough for a phone.";
"learn_card_unloaded" = "Arivu loads the model on your first message, so these appear after you have sent one.";
"learn_card_params" = "Parameters";
"learn_card_layers" = "Layers";
"learn_card_heads" = "Attention heads";
"learn_card_kv_heads" = "Key-value heads";
"learn_card_sharing" = "Heads sharing one set";
"learn_card_head_dim" = "Size of each head";
"learn_card_embd" = "Width";
"learn_card_vocab" = "Vocabulary";
"learn_card_trained_ctx" = "Trained to read";
"learn_card_kv_cost" = "Memory per token";
"learn_card_arch" = "Architecture";
"learn_billions" = "%1$@ billion";
"learn_sharing_value" = "%1$d to 1";

/* Why the processor and not the graphics chip — the Metal question (D-051). */
"learn_metal_title" = "Why not the graphics chip";
"learn_metal_body" = "On a phone the processor and the graphics chip share one pool of memory. Moving the model to the graphics chip would not make it use less — it would change memory the system can take back at any moment into memory it cannot. Arivu maps the model straight from the app, so the phone can drop it under pressure and read it back from storage. That is what lets it run on a phone with little to spare, and it is the property offloading would spend. On a phone with memory to spare the trade is worth making, and it is a property of the phone rather than of Arivu, which is why it is a setting nobody has to see.";

/* Tokens per second, explained rather than displayed. */
"learn_speed_measured_title" = "The line under each reply";
"learn_speed_measured_body" = "Under every reply Arivu prints what that reply cost: 24 in · 143 out · 9.4 tok/s. Speed is counted in tokens a second rather than words, because a token is what the model actually handles — roughly three quarters of a word. Reading and writing are not the same speed, and the reason is worth knowing. Reading is fast because your whole message is taken in at once. Writing is slower because each token depends on the one before it, so they cannot be done together. That is also why the wait before the first word is mostly reading.";
"learn_speed_tokens_in" = "in";
"learn_speed_tokens_in_body" = "Tokens Arivu read before writing anything: the instructions it is given, your message, and as much of the conversation before it as still fits. This is usually far more than you typed. Tap \"What Arivu read\" above any reply to see the exact text.";
"learn_speed_tokens_out" = "out";
"learn_speed_tokens_out_body" = "Tokens Arivu wrote in the reply.";
"learn_speed_write" = "tok/s";
"learn_speed_write_body" = "How fast the reply was written. It drops as a conversation grows, because every new token has more to look back over.";

